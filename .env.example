# ==============================================================================
# WinVoice Environment Configuration
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Local AI / Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_ROUTER_MODEL=qwen2.5:7b

# Optional Cloud LLM / Search Fallbacks
# GEMINI_API_KEY=your_gemini_api_key_here
# TAVILY_API_KEY=your_tavily_api_key_here

# Google Workspace Integration (OAuth 2.0 Client Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database Configuration (PostgreSQL / Supabase or local SQLite)
DATABASE_URL=sqlite:///./winvoice.db

# Spotify Web API Integration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# Voice & Wake-Word Configuration
WAKE_THRESHOLD=0.05
VERIFY_THRESHOLD=0.200
